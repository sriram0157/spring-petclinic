
name: Deploy Website to Azure

on:
  push:
    branches:
      - main
  workflow_dispatch:

jobs:
  deploy:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Azure Login
        uses: azure/login@v2
        with:
          creds: ${{ secrets.AZURE_CREDENTIALS }}

      - name: Create ZIP package
        run: zip -r website.zip . -x ".git/*" ".github/*"

      - name: Deploy Website
        uses: azure/webapps-deploy@v3
        with:
          app-name: spring-app
          package: website.zip

